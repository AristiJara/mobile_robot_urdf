<?xml version="1.0" ?>
<robot name="mobile_robot_urdf" xmlns:xacro="http://www.ros.org/wiki/xacro">

<!-- Fricción de las ruedas -->
<gazebo reference="wheel_left_1">
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
</gazebo>

<gazebo reference="wheel_right_1">
  <mu1>1.0</mu1>
  <mu2>1.0</mu2>
</gazebo>

<!-- Rueda loca: casi sin fricción -->
<gazebo reference="caster_wheel_1">
  <mu1>0.01</mu1>
  <mu2>0.01</mu2>
</gazebo>

<!-- LiDAR (LD06: 12 m, 10 Hz) -->
<gazebo reference="lidar_frame">
  <sensor name="lidar" type="gpu_lidar">
    <always_on>true</always_on>
    <update_rate>10</update_rate>
    <topic>scan</topic>
    <ignition_frame_id>lidar_frame</ignition_frame_id>
    <lidar>
      <scan>
        <horizontal>
          <samples>450</samples>
          <resolution>1</resolution>
          <min_angle>-3.14159</min_angle>
          <max_angle>3.14159</max_angle>
        </horizontal>
      </scan>
      <range>
        <min>0.02</min>
        <max>12.0</max>
        <resolution>0.01</resolution>
      </range>
    </lidar>
  </sensor>
</gazebo>

<!-- IMU -->
<gazebo reference="imu_frame">
  <sensor name="imu" type="imu">
    <always_on>true</always_on>
    <update_rate>100</update_rate>
    <topic>imu</topic>
    <ignition_frame_id>imu_frame</ignition_frame_id>
  </sensor>
</gazebo>

<!-- Tracción diferencial (/cmd_vel), motores de 31 rpm -->
<gazebo>
  <plugin filename="ignition-gazebo-diff-drive-system"
          name="ignition::gazebo::systems::DiffDrive">
    <left_joint>revolute_23</left_joint>
    <right_joint>revolute_24</right_joint>
    <wheel_separation>0.189</wheel_separation>
    <wheel_radius>0.034</wheel_radius>
    <odom_publish_frequency>30</odom_publish_frequency>
    <topic>/cmd_vel</topic>
    <odom_topic>/odom</odom_topic>
    <tf_topic>/tf</tf_topic>
    <frame_id>odom</frame_id>
    <child_frame_id>base_link</child_frame_id>
    <max_linear_velocity>0.11</max_linear_velocity>
    <min_linear_velocity>-0.11</min_linear_velocity>
    <max_angular_velocity>1.1</max_angular_velocity>
    <min_angular_velocity>-1.1</min_angular_velocity>
    <max_linear_acceleration>0.2</max_linear_acceleration>
    <min_linear_acceleration>-0.2</min_linear_acceleration>
    <max_angular_acceleration>1.0</max_angular_acceleration>
    <min_angular_acceleration>-1.0</min_angular_acceleration>
  </plugin>
</gazebo>

<!-- Publica el estado de las ruedas -->
<gazebo>
  <plugin filename="ignition-gazebo-joint-state-publisher-system"
          name="ignition::gazebo::systems::JointStatePublisher"/>
</gazebo>

</robot>